{
  "name": "localagent-platform",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "files": [
    "src/",
    "scripts/check-runtime.mjs",
    "localagent.config.json",
    ".env.example",
    "README.md",
    "PRD.md",
    "ARCHITECTURE.md",
    "RULES.md",
    "PHASES.md",
    "DESIGN.md",
    "THIRD_PARTY_NOTICES.md",
    "apps/workspace/dist/",
    "integrations/runtime-versions.json"
  ],
  "dependencies": {
    "@opencode-ai/sdk": "1.18.31",
    "omniroute": "3.8.52",
    "opencode-ai": "1.18.31",
    "playwright-core": "1.62.1",
    "solid-js": "1.9.17",
    "yazl": "3.3.1",
    "marked": "15.0.12",
    "dompurify": "3.4.17",
    "shiki": "4.5.0"
  },
  "scripts": {
    "start": "node src/cli.mjs start",
    "configure": "node src/cli.mjs configure",
    "agent": "node src/cli.mjs agent",
    "status": "node src/cli.mjs status",
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "verify:providers": "node src/cli.mjs verify-providers",
    "poc:start": "node scripts/start-services.mjs",
    "poc:configure": "node scripts/configure.mjs",
    "poc:demo": "node scripts/run-demo.mjs",
    "poc:verify": "node --test demo/duration.test.mjs",
    "verify:startup": "node scripts/verify-startup.mjs",
    "upstream:fetch": "node scripts/upstream-workspace.mjs fetch",
    "upstream:verify": "node scripts/upstream-workspace.mjs verify",
    "upstream:install": "node scripts/upstream-workspace.mjs install",
    "upstream:build": "node scripts/upstream-workspace.mjs build",
    "verify:upstream-ui": "node scripts/verify-upstream-ui.mjs",
    "verify:ui": "node scripts/verify-workspace-ui.mjs",
    "verify:ui:flows": "node scripts/verify-workspace-flows.mjs",
    "build:ui": "vite build --config apps/workspace/vite.config.mjs",
    "ui": "node src/workspace/launch.mjs",
    "desktop:node": "node scripts/fetch-desktop-node.mjs",
    "desktop:icon": "node scripts/create-desktop-icon.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "node scripts/build-desktop.mjs pack",
    "desktop:installer": "node scripts/build-desktop.mjs installer",
    "verify:desktop:runtime": "node scripts/verify-desktop-runtime.mjs",
    "gateway:fetch": "node scripts/omniroute-backend.mjs fetch",
    "gateway:build": "node scripts/omniroute-backend.mjs build",
    "gateway:adopt": "node scripts/omniroute-backend.mjs adopt",
    "verify:desktop": "node scripts/verify-desktop-app.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun": "1.3.14",
    "electron": "42.11.18",
    "electron-builder": "26.15.3",
    "fumadocs-mdx": "15.4.6",
    "node-loader": "2.1.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "overrides": {
    "next": "16.4.3",
    "dompurify": "3.4.17",
    "smol-toml": "1.9.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-ui": "16.17.7",
    "@fumadocs/satteri": "0.6.0",
    "katex": "0.18.2"
  }
}
